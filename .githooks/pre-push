#!/bin/sh
# enouement — check the commits being pushed (contracts/hooks.md §1). This is where FR-015 is
# judged locally — a module changed with no accepted record and no "Knowledge-None:" statement —
# because only commits carry messages. A solo developer pushing straight to main never opens a
# pull request, so CI alone would never see this.
#
# Not installed, or no knowledge store in this repository: do nothing and say nothing (FR-042).
remote=$1
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$root/.knowledge" ] || exit 0
command -v enou >/dev/null 2>&1 || exit 0

is_zero() { case $1 in *[!0]*) return 1 ;; *) return 0 ;; esac; }

result=0
while read -r local_ref local_sha remote_ref remote_sha; do
  is_zero "$local_sha" && continue # deleting a ref: nothing to check
  if is_zero "$remote_sha"; then
    # A new branch: measure from where it left the remote's default branch, if that is known.
    base=$(git merge-base "$local_sha" "refs/remotes/$remote/HEAD" 2>/dev/null) || base=""
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    enou lint --range "$base..$local_sha"
  else
    echo "enouement pre-push: no base to compare $local_ref with; checking the store only" >&2
    enou lint
  fi
  status=$?
  case $status in
    0) ;;
    1) echo "enouement pre-push: enou lint refused to run (exit 1); $local_ref is not checked" >&2 ;;
    *) result=$status ;;
  esac
done
exit $result
